        { text: "У меня твёрдый решительный взгляд?", v: "Нет", p: "Да", k: "Мягкий" },
        { text: "Я коплю вещи?", v: "Нет, выбрасываю", p: "Только нужное", k: "Да, тяжело расстаюсь" },
        { text: "Мне нравится учить других?", v: "Делиться идеями", p: "Наставлять, указывать", k: "Помогать" },
        { text: "Мой нос часто заложен?", v: "Сухость", p: "Аллергия", k: "Слизь, насморк" },
        { text: "Я быстро моргаю?", v: "Да", p: "Нормально", k: "Редко" },
        { text: "Мне сложно начать дело?", v: "Легко, но бросаю", p: "Начинаю резко", k: "Долго раскачиваюсь" }
    ];

    // состояние
    let mainAnswers = new Array(36).fill(null);
    let detailAnswers = new Array(24).fill(null);
    let currentMainIndex = 0;
    let currentDetailIndex = 0;
    let mainCounts = { v:0, p:0, k:0 };
    let detailCounts = { v:0, p:0, k:0 };

    // canvas
    const canvases = {
        v: document.getElementById('flowerVata'),
        p: document.getElementById('flowerPitta'),
        k: document.getElementById('flowerKapha')
    };
    const ctx = {
        v: canvases.v.getContext('2d'),
        p: canvases.p.getContext('2d'),
        k: canvases.k.getContext('2d')
    };

    function drawFlower(type, stage) {
        const canvas = canvases[type];
        const c = ctx[type];
        c.clearRect(0,0,140,150);
        const s = Math.min(12, Math.max(1, stage));
        c.fillStyle = '#ab8e6a';
        c.fillRect(30,120,80,25);
        c.fillStyle = '#6d8f6d';
        c.fillRect(40,100,60,25);
        let stemHeight = 20 + s*4;
        c.fillStyle = '#53823b';
        c.fillRect(68,120-stemHeight,8,stemHeight);
        if (type === 'v') {
            c.fillStyle = '#b39bc8';
            for (let i=0; i<3+s%5; i++) {
                c.beginPath();
                c.ellipse(72+(i-1)*10, 90-stemHeight+i*6, 8+s*0.3, 12, 0, 0, Math.PI*2);
                c.fillStyle = '#b19cd9';
                c.fill();
            }
        } else if (type === 'p') {
            c.fillStyle = '#f09c5a';
            for (let i=0; i<4; i++) {
                c.beginPath();
                c.ellipse(72+(i-2)*11, 86-stemHeight+i*4, 10, 16, 0.2, 0, Math.PI*2);
                c.fillStyle = '#f38b3e';
                c.fill();
            }
        } else {
            c.fillStyle = '#6da68a';
            for (let i=0; i<4; i++) {
                c.beginPath();
                c.arc(72+(i-2)*12, 86-stemHeight+i*5, 10+s*0.5, 0, Math.PI*2);
                c.fillStyle = '#4e9e81';
                c.fill();
            }
        }
        c.fillStyle = '#f3d674';
        c.beginPath();
        c.arc(72, 84-stemHeight, 8, 0, 2*Math.PI);
        c.fill();
    }

    function updateFlowersFromMain() {
        let maxMain = 12; // 36 вопросов /3 = 12 максимум на дошу
        drawFlower('v', Math.min(12, Math.floor((mainCounts.v / maxMain) * 12) + 1));
        drawFlower('p', Math.min(12, Math.floor((mainCounts.p / maxMain) * 12) + 1));
        drawFlower('k', Math.min(12, Math.floor((mainCounts.k / maxMain) * 12) + 1));
    }

    // подсчёт main из массива
    function recalcMain() {
        mainCounts = { v:0, p:0, k:0 };
        for (let a of mainAnswers) { if (a === 'v') mainCounts.v++; else if (a === 'p') mainCounts.p++; else if (a === 'k') mainCounts.k++; }
    }

    function recalcDetail() {
        detailCounts = { v:0, p:0, k:0 };
        for (let a of detailAnswers) { if (a === 'v') detailCounts.v++; else if (a === 'p') detailCounts.p++; else if (a === 'k') detailCounts.k++; }
    }

    // рендер основного вопроса
    function renderMainQuestion() {
        const q = mainQuestions[currentMainIndex];
        document.getElementById('questionDisplay').innerText = q.text;
        const sel = mainAnswers[currentMainIndex];
        document.getElementById('answersContainer').innerHTML = `
            <div class="answer-btn vata ${sel==='v'?'selected-v':''}" data-dosha="v"><span class="dot vata-dot"></span>${q.v}</div>
            <div class="answer-btn pitta ${sel==='p'?'selected-p':''}" data-dosha="p"><span class="dot pitta-dot"></span>${q.p}</div>
            <div class="answer-btn kapha ${sel==='k'?'selected-k':''}" data-dosha="k"><span class="dot kapha-dot"></span>${q.k}</div>
        `;
        document.querySelectorAll('.answer-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                let dosha = btn.dataset.dosha;
                if (mainAnswers[currentMainIndex] === dosha) {
                    // снять ответ
                    mainAnswers[currentMainIndex] = null;
                } else {
                    mainAnswers[currentMainIndex] = dosha;
                }
                recalcMain();
                updateFlowersFromMain();
                renderMainQuestion();
            });
        });
        document.getElementById('prevBtn').disabled = (currentMainIndex === 0);
        const nextBtn = document.getElementById('nextBtn');
        nextBtn.disabled = (mainAnswers[currentMainIndex] === null);
        document.getElementById('questionCounter').innerText = `Вопрос ${currentMainIndex+1} / 36`;
        document.getElementById('progressFill').style.width = `${((currentMainIndex+1)/36)*100}%`;
        if (currentMainIndex === 35 && mainAnswers[35] !== null) {
            document.getElementById('submitArea').innerHTML = '<button class="btn-small" id="showInterimBtn">🌸 предварительный итог</button>';
            document.getElementById('showInterimBtn')?.addEventListener('click', showInterim);
        } else {
            document.getElementById('submitArea').innerHTML = '';
        }
    }

    function showInterim() {
        document.getElementById('quizScreen').classList.remove('active');
        document.getElementById('interimScreen').classList.add('active');
        let total = mainCounts.v + mainCounts.p + mainCounts.k;
        let vPerc = Math.round((mainCounts.v/36)*100);
        let pPerc = Math.round((mainCounts.p/36)*100);
        let kPerc = 100 - vPerc - pPerc;
        document.getElementById('interimChart').innerHTML = `
            <div class="result-row"><span class="bar-label vata-label">ВАТА</span><div class="bar-bg"><div class="bar-fill vata-fill" style="width:${vPerc}%">${vPerc}%</div></div></div>
            <div class="result-row"><span class="bar-label pitta-label">ПИТТА</span><div class="bar-bg"><div class="bar-fill pitta-fill" style="width:${pPerc}%">${pPerc}%</div></div></div>
            <div class="result-row"><span class="bar-label kapha-label">КАПХА</span><div class="bar-bg"><div class="bar-fill kapha-fill" style="width:${kPerc}%">${kPerc}%</div></div></div>
        `;
        let dominant = (mainCounts.v>=mainCounts.p && mainCounts.v>=mainCounts.k) ? 'вата' : (mainCounts.p>=mainCounts.k ? 'питта' : 'капха');
        if (Math.max(mainCounts.v, mainCounts.p, mainCounts.k) < 15) dominant = 'смешанный тип';
        document.getElementById('interimRecommendation').innerHTML = `<strong>🌿 предварительно: ${dominant}</strong><br>Далее уточняющие вопросы помогут углубить результат.`;
    }

    // уточняющие
    function renderDetailQuestion() {
        const q = detailQuestions[currentDetailIndex];
        document.getElementById('detailQuestionDisplay').innerText = q.text;
        const sel = detailAnswers[currentDetailIndex];
        document.getElementById('detailAnswersContainer').innerHTML = `
            <div class="answer-btn vata ${sel==='v'?'selected-v':''}" data-dosha="v"><span class="dot vata-dot"></span>${q.v}</div>
            <div class="answer-btn pitta ${sel==='p'?'selected-p':''}" data-dosha="p"><span class="dot pitta-dot"></span>${q.p}</div>
            <div class="answer-btn kapha ${sel==='k'?'selected-k':''}" data-dosha="k"><span class="dot kapha-dot"></span>${q.k}</div>
        `;
        document.querySelectorAll('#detailAnswersContainer .answer-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                let dosha = btn.dataset.dosha;
                if (detailAnswers[currentDetailIndex] === dosha) {
                    detailAnswers[currentDetailIndex] = null;
                } else {
                    detailAnswers[currentDetailIndex] = dosha;
                }
                recalcDetail();
                renderDetailQuestion();
            });
        });
        document.getElementById('detailPrevBtn').disabled = (currentDetailIndex === 0);
        const nextBtn = document.getElementById('detailNextBtn');
        nextBtn.disabled = (detailAnswers[currentDetailIndex] === null);
        document.getElementById('questionCounter').innerText = `Уточнение ${currentDetailIndex+1} / 24`;
        document.getElementById('progressFill').style.width = `${((currentDetailIndex+1)/24)*100}%`;
        if (currentDetailIndex === 23 && detailAnswers[23] !== null) {
            document.getElementById('detailSubmitArea').innerHTML = '<button class="btn-small" id="showFinalBtn">🌸 финальный результат</button>';
            document.getElementById('showFinalBtn')?.addEventListener('click', showFinal);
        } else {
            document.getElementById('detailSubmitArea').innerHTML = '';
        }
    }

    function showFinal() {
        document.getElementById('detailScreen').classList.remove('active');
        document.getElementById('finalResultScreen').classList.add('active');
        let totalV = mainCounts.v + detailCounts.v;
        let totalP = mainCounts.p + detailCounts.p;
        let totalK = mainCounts.k + detailCounts.k;
        let grandTotal = totalV + totalP + totalK; // 60
        let vPerc = Math.round((totalV/grandTotal)*100);
        let pPerc = Math.round((totalP/grandTotal)*100);
        let kPerc = 100 - vPerc - pPerc;
        document.getElementById('finalChart').innerHTML = `
            <div class="result-row"><span class="bar-label vata-label">ВАТА</span><div class="bar-bg"><div class="bar-fill vata-fill" style="width:${vPerc}%">${vPerc}%</div></div></div>
            <div class="result-row"><span class="bar-label pitta-label">ПИТТА</span><div class="bar-bg"><div class="bar-fill pitta-fill" style="width:${pPerc}%">${pPerc}%</div></div></div>
            <div class="result-row"><span class="bar-label kapha-label">КАПХА</span><div class="bar-bg"><div class="bar-fill kapha-fill" style="width:${kPerc}%">${kPerc}%</div></div></div>
        `;
        let max = Math.max(totalV, totalP, totalK);
        let dominant = (max === totalV) ? 'вата' : (max === totalP ? 'питта' : 'капха');
        if (totalV===totalP || totalP===totalK || totalV===totalK) dominant = 'смешанный';
        document.getElementById('finalRecommendation').innerHTML = `<strong>🌸 ваша доша: ${dominant.toUpperCase()}</strong><br>Рекомендации: тёплая маслянистая пища для ваты, охлаждающая для питты, лёгкая и сухая для капхи. Детальнее — по доминанте.`;
    }

    // копирование финала (работает и на телефоне)
    document.getElementById('finalCopyBtn').addEventListener('click', ()=>{
        let totalV = mainCounts.v + detailCounts.v;
        let totalP = mainCounts.p + detailCounts.p;
        let totalK = mainCounts.k + detailCounts.k;
        let grand = totalV+totalP+totalK;
        let vPerc = Math.round((totalV/grand)*100);
        let pPerc = Math.round((totalP/grand)*100);
        let kPerc = 100 - vPerc - pPerc;
        let text = `🌿 Аюрведа — цветущий сад (полный тест)\nВата: ${vPerc}%\nПитта: ${pPerc}%\nКапха: ${kPerc}%\nПодробнее на сайте.`;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => alert('Скопировано!')).catch(() => fallbackCopy(text));
        } else {
            fallbackCopy(text);
        }
        function fallbackCopy(t) {
            let ta = document.createElement('textarea');
            ta.value = t;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            alert('Скопировано (резервный метод)');
        }
    });

    // сброс
    function restart() {
        mainAnswers = new Array(36).fill(null);
        detailAnswers = new Array(24).fill(null);
        currentMainIndex = 0; currentDetailIndex = 0;
        recalcMain(); recalcDetail();
        updateFlowersFromMain();
        document.getElementById('startScreen').classList.add('active');
        document.getElementById('quizScreen').classList.remove('active');
        document.getElementById('interimScreen').classList.remove('active');
        document.getElementById('detailScreen').classList.remove('active');
        document.getElementById('finalResultScreen').classList.remove('active');
    }

    // навигация
    document.getElementById('startBtn').addEventListener('click', ()=>{
        restart();
        document.getElementById('startScreen').classList.remove('active');
        document.getElementById('quizScreen').classList.add('active');
        renderMainQuestion();
    });
    document.getElementById('prevBtn').addEventListener('click', ()=>{
        if (currentMainIndex > 0) { currentMainIndex--; renderMainQuestion(); }
    });
    document.getElementById('nextBtn').addEventListener('click', ()=>{
        if (mainAnswers[currentMainIndex] !== null && currentMainIndex < 35) {
            currentMainIndex++; renderMainQuestion();
        }
    });
    document.getElementById('continueToDetailed').addEventListener('click', ()=>{
        document.getElementById('interimScreen').classList.remove('active');
        document.getElementById('detailScreen').classList.add('active');
        currentDetailIndex = 0;
        renderDetailQuestion();
    });
    document.getElementById('restartFromInterim').addEventListener('click', restart);
    document.getElementById('detailPrevBtn').addEventListener('click', ()=>{
        if (currentDetailIndex > 0) { currentDetailIndex--; renderDetailQuestion(); }
    });
    document.getElementById('detailNextBtn').addEventListener('click', ()=>{
        if (detailAnswers[currentDetailIndex] !== null && currentDetailIndex < 23) {
            currentDetailIndex++; renderDetailQuestion();
        }
    });
    document.getElementById('finalRestartBtn').addEventListener('click', restart);

    // инициализация цветов
    drawFlower('v',1);
    drawFlower('p',1);
    drawFlower('k',1);
    restart();
})();
</script>
</body>
</html>
