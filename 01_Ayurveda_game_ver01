<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes">
    <title>Аюрведа — цветущий сад (полная версия)</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Roboto, 'Open Sans', system-ui, sans-serif;
            background: linear-gradient(145deg, #f0f7e9 0%, #e1efe0 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px 12px;
            color: #2f4b3c;
        }

        .game-container {
            max-width: 800px;
            width: 100%;
            background: rgba(255, 250, 235, 0.7);
            backdrop-filter: blur(8px);
            border-radius: 48px 48px 32px 32px;
            box-shadow: 0 20px 40px rgba(90, 70, 50, 0.15), 0 4px 12px rgba(60, 80, 60, 0.1);
            padding: 24px 20px 30px;
            border: 2px solid #e2dccd;
        }

        /* Цветы (canvas) */
        .garden {
            display: flex;
            justify-content: space-around;
            align-items: flex-end;
            gap: 8px;
            margin-bottom: 24px;
            padding: 10px 5px;
            background: #d9c9b4;
            background: radial-gradient(circle at 20% 80%, #c7b69e, #dacbb8);
            border-radius: 120px 120px 60px 60px;
            border-bottom: 8px solid #988f7a;
        }

        .flower-pot {
            text-align: center;
            flex: 1;
            min-width: 80px;
        }

        .flower-pot canvas {
            display: block;
            width: 100%;
            height: auto;
            max-width: 140px;
            margin: 0 auto;
            filter: drop-shadow(0 8px 6px #7f6e5b);
            transition: transform 0.2s ease;
        }

        .flower-label {
            font-size: 14px;
            font-weight: 600;
            margin-top: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .vata-label { color: #6b4f7c; }
        .pitta-label { color: #b45f3a; }
        .kapha-label { color: #3f786a; }

        /* прогресс */
        .progress-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 16px;
            margin: 16px 0 8px;
            color: #4f6143;
            font-weight: 500;
            background: #e6e3d3;
            padding: 8px 16px;
            border-radius: 50px;
        }
        .progress-bar-bg {
            height: 10px;
            background: #c5bcac;
            border-radius: 20px;
            flex: 1;
            margin: 0 12px;
        }
        .progress-fill {
            height: 10px;
            background: #8ba888;
            width: 0%;
            border-radius: 20px;
            transition: width 0.3s;
        }

        /* экраны */
        .screen {
            display: none;
            animation: fade 0.25s;
        }
        .screen.active {
            display: block;
        }
        @keyframes fade { from { opacity:0.3; } to { opacity:1; } }

        /* стартовый экран */
        .start-screen {
            text-align: center;
            padding: 24px 12px;
        }
        h1 {
            font-size: 2.2rem;
            color: #3f6040;
            margin: 16px 0 8px;
            font-weight: 400;
            letter-spacing: 2px;
            text-shadow: 3px 3px 0 #ebe1cf;
        }
        .subtitle {
            font-size: 1.2rem;
            color: #6d7a5a;
            margin-bottom: 32px;
            background: #f1ecdb;
            display: inline-block;
            padding: 10px 24px;
            border-radius: 60px;
        }

        /* ВСЕ КНОПКИ ТЕПЕРЬ ЗАКРУГЛЕНЫ */
        .btn {
            background: #adc5a7;
            border: none;
            color: #2e4a37;
            font-weight: 600;
            font-size: 1.3rem;
            padding: 16px 42px;
            border-radius: 60px; /* закругление */
            box-shadow: 0 10px 0 #6e8b6e, 0 4px 20px rgba(0,0,0,0.1);
            cursor: pointer;
            transition: all 0.08s linear;
            margin: 24px 0 16px;
            border: 1px solid #ebdfca;
        }
        .btn:active {
            transform: translateY(6px);
            box-shadow: 0 4px 0 #6e8b6e;
        }
        .btn-small {
            font-size: 1.1rem;
            padding: 12px 24px;
            border-radius: 50px; /* закругление */
            background: #c4d5b5;
            box-shadow: 0 5px 0 #8a9e7a;
            border: none;
            font-weight: 600;
            color: #2a412a;
            cursor: pointer;
            transition: 0.1s;
        }
        .btn-small:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #8a9e7a;
        }
        .btn-small:disabled {
            opacity: 0.4;
            transform: none;
            box-shadow: 0 5px 0 #8a9e7a;
            pointer-events: none;
        }

        /* вопросы */
        .question-text {
            font-size: 1.6rem;
            font-weight: 500;
            line-height: 1.3;
            margin: 20px 0 28px;
            color: #2d4a38;
            background: #fffef7;
            padding: 20px 18px;
            border-radius: 40px;
            box-shadow: inset 0 2px 6px #ddd6c4;
        }

        .answers-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin: 32px 0;
        }
        .answer-btn {
            background: #fcf9f0;
            border: 3px solid transparent;
            border-radius: 50px; /* закругленные углы */
            padding: 18px 22px;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 20px;
            cursor: pointer;
            transition: 0.15s;
            box-shadow: 0 6px 0 #b9ad95;
            color: #2e3f2e;
            font-weight: 500;
        }
        .answer-btn.vata:hover { background: #e7daf0; border-color: #9b7bb5; }
        .answer-btn.pitta:hover { background: #ffead2; border-color: #d88f5c; }
        .answer-btn.kapha:hover { background: #d5efe5; border-color: #479e86; }
        .answer-btn.selected-v { background: #d7c5e8; border-color: #6b4f7c; transform: scale(1.02); }
        .answer-btn.selected-p { background: #ffd7b6; border-color: #b45f3a; }
        .answer-btn.selected-k { background: #bae1d6; border-color: #3f786a; }

        .dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .vata-dot { background: #8a6d9c; box-shadow: 0 0 0 3px #e9d6ff; }
        .pitta-dot { background: #d97c42; box-shadow: 0 0 0 3px #ffdbb5; }
        .kapha-dot { background: #46947b; box-shadow: 0 0 0 3px #c7f0e2; }

        .nav-buttons {
            display: flex;
            justify-content: space-between;
            margin: 24px 0 10px;
        }

        /* результаты */
        .result-chart {
            background: #fbf5e6;
            border-radius: 32px;
            padding: 24px;
            margin: 20px 0;
        }
        .result-row {
            display: flex;
            align-items: center;
            margin: 16px 0;
            gap: 12px;
        }
        .bar-label {
            width: 70px;
            font-weight: 700;
            font-size: 1.2rem;
        }
        .bar-bg {
            flex: 1;
            height: 32px;
            background: #ddd2bf;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: inset 0 2px 5px #9e917d;
        }
        .bar-fill {
            height: 100%;
            width: 0%;
            color: #fff;
            line-height: 32px;
            padding-left: 16px;
            font-weight: bold;
            text-shadow: 1px 1px 2px black;
            transition: width 0.5s;
            white-space: nowrap;
        }
        .vata-fill { background: #886aa7; }
        .pitta-fill { background: #c9682c; }
        .kapha-fill { background: #308770; }

        .recommendation-box {
            background: #e1dccb;
            border-radius: 24px;
            padding: 22px;
            font-size: 1.2rem;
            margin: 28px 0 18px;
            color: #27402b;
            border-left: 16px solid #9fbb9a;
        }
        .disclaimer {
            font-size: 0.8rem;
            color: #6f706b;
            text-align: center;
            margin-top: 30px;
            border-top: 1px dashed #b7aa95;
            padding-top: 16px;
        }
        .copy-btn {
            background: #b1bb9d;
            box-shadow: 0 5px 0 #727e63;
            font-size: 1.1rem;
            padding: 12px 18px;
            margin: 8px 8px;
            border-radius: 50px;
            border: none;
        }
        .row-buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }
        .stage-header {
            font-size: 1.8rem;
            margin: 15px 0;
            color: #42633b;
        }
    </style>
</head>
<body>
<div class="game-container" id="gameContainer">
    <!-- три цветка всегда сверху -->
    <div class="garden" id="garden">
        <div class="flower-pot"><canvas id="flowerVata" width="140" height="150"></canvas><div class="flower-label vata-label">ВАТА</div></div>
        <div class="flower-pot"><canvas id="flowerPitta" width="140" height="150"></canvas><div class="flower-label pitta-label">ПИТТА</div></div>
        <div class="flower-pot"><canvas id="flowerKapha" width="140" height="150"></canvas><div class="flower-label kapha-label">КАПХА</div></div>
    </div>

    <!-- Прогресс (виджет) -->
    <div class="progress-area" id="progressArea">
        <span id="questionCounter">Вопрос 1 / 36</span>
        <div class="progress-bar-bg"><div class="progress-fill" id="progressFill" style="width: 2.7%;"></div></div>
    </div>

    <!-- Экран 1: старт -->
    <div id="startScreen" class="screen active">
        <div class="start-screen">
            <h1>🌿 Аюрведа<br>цветущий сад</h1>
            <div class="subtitle">полная версия · 60 вопросов</div>
            <p style="font-size:1.2rem; margin: 20px;">Сначала 36 основных вопросов, затем 24 уточняющих</p>
            <button class="btn" id="startBtn">Начать тест</button>
        </div>
    </div>

    <!-- Экран 2: основной тест (36 вопросов) -->
    <div id="quizScreen" class="screen">
        <div class="question-text" id="questionDisplay">...</div>
        <div class="answers-grid" id="answersContainer"></div>
        <div class="nav-buttons">
            <button class="btn-small" id="prevBtn" disabled>← Назад</button>
            <button class="btn-small" id="nextBtn" disabled>Далее →</button>
        </div>
        <div style="text-align: center;" id="submitArea"></div>
    </div>

    <!-- Экран 3: промежуточный результат -->
    <div id="interimScreen" class="screen">
        <h2 class="stage-header">🌱 первая часть завершена</h2>
        <div class="result-chart" id="interimChart"></div>
        <div class="recommendation-box" id="interimRecommendation"></div>
        <div style="display: flex; justify-content: center; gap: 20px;">
            <button class="btn-small" id="continueToDetailed">📌 продолжить (уточняющие 24)</button>
            <button class="btn-small" id="restartFromInterim">🔄 заново</button>
        </div>
    </div>

    <!-- Экран 4: уточняющие вопросы (24 шт) -->
    <div id="detailScreen" class="screen">
        <div class="question-text" id="detailQuestionDisplay">...</div>
        <div class="answers-grid" id="detailAnswersContainer"></div>
        <div class="nav-buttons">
            <button class="btn-small" id="detailPrevBtn" disabled>← Назад</button>
            <button class="btn-small" id="detailNextBtn" disabled>Далее →</button>
        </div>
        <div style="text-align: center;" id="detailSubmitArea"></div>
    </div>

    <!-- Экран 5: финальный результат -->
    <div id="finalResultScreen" class="screen">
        <h2 class="stage-header">🌸 ваш полный портрет</h2>
        <div class="result-chart" id="finalChart"></div>
        <div class="recommendation-box" id="finalRecommendation"></div>
        <div class="row-buttons">
            <button class="btn-small copy-btn" id="finalCopyBtn">📋 скопировать итог</button>
            <button class="btn-small copy-btn" id="finalRestartBtn">🔄 заново</button>
        </div>
    </div>

    <!-- Дисклеймер -->
    <div class="disclaimer">⚠️ Игра не является медицинским диагнозом. Для точной диагностики обратитесь к специалисту по Аюрведе.</div>
</div>

